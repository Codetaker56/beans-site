# --- repo source: github (default), forgejo, or mixed ---
REPO_SOURCE="github"
GITHUB_USERNAME=""
# optional, raises GitHub API rate limit (60/hr -> 5000/hr)
GITHUB_API_TOKEN=""

# only for REPO_SOURCE = forgejo or mixed
FORGEJO_BASE_URL=""
FORGEJO_USERNAME=""
FORGEJO_API_TOKEN=""

# --- discord presence widget (optional) ---
# leave DISCORD_BOT_TOKEN blank to disable. Bot must share a server with the
# user and have the Presence intent enabled.
DISCORD_USER_ID=""
DISCORD_GUILD_ID=""
DISCORD_BOT_TOKEN=""

# --- notebook (Discord OAuth) + admin login ---
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI="http://localhost:8782/auth/discord/callback"
ADMIN_DISCORD_ID=""
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""
# long random string, signs session cookies
SESSION_SECRET=""
# postgres connection string
DATABASE_URL=""

EXPRESS_PORT=8782
NODE_ENV="development"
